{
  "manifest_version": 3,
  "name": "1분에디터",
  "short_name": "1분에디터",
  "version": "0.1.0",
  "description": "참고 홈페이지 전체를 캡처하고, 새 홈페이지 방향에 맞는 문구를 만듭니다.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "clipboardWrite", "scripting", "sidePanel", "storage"],
  "host_permissions": [
    "<all_urls>",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "1분에디터 열기",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/sidepanel.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
